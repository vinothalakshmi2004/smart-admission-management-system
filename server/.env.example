# ── Required ──
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/smart_admission
# Long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# ── First admin account (created only when no admin exists) ──
ADMIN_NAME=RVS Admin
ADMIN_EMAIL=admin@yourcollege.edu
ADMIN_PASSWORD=change_this_strong_password

# ── Only when the React app is hosted on a different domain than the API ──
# Comma-separated list of allowed browser origins
# CLIENT_URL=https://admissions.yourcollege.edu

# ── Razorpay online payment ──
# Dashboard -> switch to Test Mode -> Account & Settings -> API Keys -> Generate Key
# Test keys start with rzp_test_ ; replace with rzp_live_ keys only after KYC/activation.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret
